{
  "name": "saff-2026-predictor",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:client": "npm run dev --workspace=frontend",
    "dev:server": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
